# Backend Settings
PROJECT_NAME="Career & Skill Intelligence Platform"
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-use-a-32-byte-hex-string

# Database
# Default: local sqlite file for instantaneous zero-setup development
# For production/Supabase PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./career_intel.db

# LLM Service (Google Gemini / OpenAI / Fallback)
# Leave blank to use built-in deterministic offline fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

# Supabase Auth (Optional for advanced auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
